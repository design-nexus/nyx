#!/usr/bin/env bash
# nyx: install, update and remove Nyx apps.
#
#   nyx icons check | generate | sync | restore | follow on|off   theme launcher icons
#   nyx list                   the apps, and which are installed
#   nyx install APP… | all     install apps (pass --default to open their files)
#   nyx update                 rebuild every installed app from the latest source
#   nyx uninstall APP… [--purge]
#   nyx share FILE…            share through the Share Sheet (nyx share --help)
#   nyx display virtual …      split a wide screen into virtual monitors (nyx display --help)
#   nyx apps                   what Nyx apps can do from here (nyx apps help APP)
#   nyx APP [ACTION] [ARGS…]   an app's action: nyx notes create "Ideas", nyx music jazz
#   nyx completion SHELL       completions for bash, zsh or fish
set -euo pipefail

REPO="design-nexus/nyx"
RAW="https://raw.githubusercontent.com/$REPO/main"
ALL=(settings contacts activity torrents pdf notepad music media-player theater chat fonts archive office photos glimpse store git passwords weather news capture pulse containers files cloud notes calculator home maps transfer mail calendar reminders share dock control-center notification-center clipboard switcher)
bin="$HOME/.local/bin"

# The program that shows an app is installed.
program() {
  case $1 in
    office) echo nyx-office ;;
    photos) echo nyx-photos ;;
    cloud) echo nyx-cloudd ;;
    *) echo "nyx-$1" ;;
  esac
}

builtins="icons list install update uninstall remove share display dev release apps completion"

# Nyx apps' actions, through nyx-actions (built from nyx-core with the CLI).
actions_bin() {
  if [[ -x $bin/nyx-actions ]]; then echo "$bin/nyx-actions"; else command -v nyx-actions; fi
}

actions() {
  local found
  found=$(actions_bin) || { echo "nyx-actions is missing; reinstall the Nyx CLI." >&2; exit 1; }
  exec "$found" "$@"
}

installed() {
  for a in "${ALL[@]}" assistant; do [[ -x $bin/$(program "$a") ]] && echo "$a"; done
  # Activity was called Tasks; updating an old install renames it.
  [[ -x $bin/nyx-tasks && ! -x $bin/nyx-activity ]] && echo activity
  return 0
}

run() {
  local script=$1
  shift
  curl -fsSL "$RAW/$script" | bash -s -- "$@"
}

case ${1:-} in
  icons)
    shift
    here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    tooling="$here/../tools/icons.py"
    [[ -f $tooling ]] || tooling="${XDG_DATA_HOME:-$HOME/.local/share}/nyx/icon-tools/icons.py"
    [[ -f $tooling ]] || { echo "Nyx icon tools are missing; reinstall the Nyx CLI." >&2; exit 1; }
    exec /usr/bin/python3 "$tooling" "$@" ;;
  dev | release)
    here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    tooling="$here/../tools/suite.py"
    if [[ ! -f $tooling ]]; then
      tooling="${XDG_DATA_HOME:-$HOME/.local/share}/nyx/dev/suite.py"
    fi
    if [[ ! -f $tooling ]]; then
      suite_home="${XDG_DATA_HOME:-$HOME/.local/share}/nyx/development"
      [[ -e $suite_home ]] || git clone "https://github.com/$REPO.git" "$suite_home"
      tooling="$suite_home/tools/suite.py"
    fi
    exec python3 "$tooling" "$@" ;;
  list)
    for a in "${ALL[@]}"; do
      if [[ -x $bin/$(program "$a") ]]; then printf '  %-13s installed\n' "$a"; else printf '  %s\n' "$a"; fi
    done ;;
  install) shift; run install.sh "$@" ;;
  update)
    mapfile -t apps < <(installed)
    ((${#apps[@]})) || { echo "No Nyx apps are installed."; exit 0; }
    run install.sh "${apps[@]}" ;;
  uninstall | remove) shift; run uninstall.sh "$@" ;;
  share)
    shift
    [[ -x $bin/nyx-share ]] || { echo "Share isn't installed. Install it with: nyx install share" >&2; exit 1; }
    exec "$bin/nyx-share" "$@" ;;
  display)
    shift
    display=$(command -v nyx-display || echo "$bin/nyx-display")
    [[ -x $display ]] || { echo "nyx display comes with Settings. Install it with: nyx install settings" >&2; exit 1; }
    exec "$display" "$@" ;;
  apps)
    shift
    case ${1:-} in
      help) shift; actions help "$@" ;;
      list) shift; actions apps "$@" ;;
      *) actions apps "$@" ;;
    esac ;;
  completion)
    shift
    # shellcheck disable=SC2086 # the built-in commands are words
    actions completion "${1:-bash}" $builtins ;;
  "" | -h | --help | help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; [[ -n ${1:-} ]] ;;
  *)
    # An app's command, or nyx-actions' "did you mean" for a word nothing answers to.
    if found=$(actions_bin); then
      exec "$found" run "$@"
    fi
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
